<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Supabase Auth and authenticated HTTPS RPCs. No administrator key is shipped. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 승인된 범위의 퍼미션만 선언할 것. AppContainer의 CoreFeature와 맞춘다 -->
    <!-- EV 배터리(SoC·충전구·용량) → CoreFeature.EV_BATTERY -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 내비 위치·경로 조회 → CoreFeature.NAVI -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 길안내 요청(S2 [길안내]) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 충전 기록 포그라운드 서비스 + 시동 때 자동 시작(PRD 8절, RecordingService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 기록 중 알림 카드(Android 13+ 런타임 동의). 거부해도 서비스는 돈다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChachelinApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- DO(distractionOptimized) 미선언: 주행 중에는 플랫폼이 앱 사용을 막는다(PRD 3.2, 정차 전용 앱) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records EV charging sessions while the app is in the background so charging stations can be rated from verified charges" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
