<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 승인된 범위의 퍼미션만 선언할 것. AppContainer의 CoreFeature와 맞춘다 -->
    <!-- EV 배터리(SoC·충전구·용량) → CoreFeature.EV_BATTERY -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 내비 위치·경로 조회 → CoreFeature.NAVI -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 길안내 요청(S2 [길안내]) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".ChachelinApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- DO(distractionOptimized) 미선언: 주행 중에는 플랫폼이 앱 사용을 막는다(PRD 3.2, 정차 전용 앱) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
